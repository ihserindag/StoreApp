@model ProductListViewModel


<div class="row">
    <div class="col-md-3">
        <h4>Kategoriler</h4>
        <vc:categories-list />
    </div>
    <div class="col-md-9">
        
           

                @if (Model.Products.Count() == 0)
                {
                    <p>Urun Bulunamadi</p>
                }
                else
                {
                    <h3>Urunler</h3>
                }
           


                @foreach (var product in Model.Products)
                {
                    <div class="card card-outline-secondary mb-3 p-2">
                    <div class=" d-flex justify-content-between  align-items-center ">
                        <div>
                            <h4>@product.Name</h4>
                            <p>@product.Description</p>
                           
                        </div>
                        <div>
                            <span class="badge rounded-pill text-bg-success">@product.Price</span>
                        </div>
                    </div>
                    </div>
                            }

                        
                   
        <div class="my-2 btn-group"
             page-model="Model.PageInfo"
             page-action="Index"
             page-class="btn"
             page-class-link="btn-outline-secondary"
             page-class-active=" btn-secondary"
             page-url-category="@ViewContext.RouteData.Values["category"]">

        </div>


    </div>
</div>




